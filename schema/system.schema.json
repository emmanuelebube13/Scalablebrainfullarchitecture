{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A Scalable Brain subsystem",
  "description": "One file per subsystem. Copy templates/system.template.json to add System N.",
  "type": "object",
  "required": ["schema_version", "id", "ordinal", "name", "status", "summary", "sections"],
  "properties": {
    "schema_version": { "type": "string" },
    "id": { "type": "string", "pattern": "^system-[0-9]+$" },
    "ordinal": { "type": "integer" },
    "name": { "type": "string" },
    "role": { "type": "string" },
    "host": { "type": "string" },
    "duty_cycle": { "type": "string" },
    "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "repository": { "type": "string" },
    "code_root": { "type": "string" },
    "status": {
      "type": "object",
      "required": ["state", "as_of"],
      "properties": {
        "state": { "type": "string" },
        "as_of": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "note": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "required": ["technical"],
      "properties": { "technical": { "type": "string" }, "plain": { "type": "string" } }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "value"],
        "properties": { "label": { "type": "string" }, "value": { "type": "string" } }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "kind": { "type": "string" },
          "body": {
            "type": "object",
            "properties": {
              "technical": { "type": "array", "items": { "type": "string" } },
              "plain": { "type": "array", "items": { "type": "string" } }
            }
          },
          "stages": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["code", "name"],
              "properties": {
                "code": { "type": "string" },
                "name": { "type": "string" },
                "module": { "type": "string" },
                "output": { "type": "string" },
                "technical": { "type": "string" },
                "plain": { "type": "string" }
              }
            }
          },
          "tables": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["columns", "rows"],
              "properties": {
                "title": { "type": "string" },
                "columns": { "type": "array", "items": { "type": "string" } },
                "rows": { "type": "array", "items": { "type": "array" } },
                "note": { "type": "string" }
              }
            }
          },
          "callouts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["title"],
              "properties": {
                "tone": { "type": "string", "enum": ["good", "info", "warn", "bad"] },
                "title": { "type": "string" },
                "technical": { "type": "string" },
                "plain": { "type": "string" }
              }
            }
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "severity", "title", "text"],
              "properties": {
                "id": { "type": "string" },
                "severity": { "type": "string", "enum": ["high", "med", "low"] },
                "title": { "type": "string" },
                "text": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
